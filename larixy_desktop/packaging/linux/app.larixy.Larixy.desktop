# SPDX-License-Identifier: AGPL-3.0-or-later
[Desktop Entry]
Name=Larixy
GenericName=Instant Messenger
Comment=Instant messaging and VoIP
Exec=app.larixy.Larixy %U
TryExec=app.larixy.Larixy
Icon=app.larixy.Larixy
Type=Application
Categories=Network;InstantMessaging;Chat;
Keywords=chat;im;messaging;messenger;voip;voice;video;call;
StartupWMClass=app.larixy.Larixy
SingleMainWindow=true
StartupNotify=true
MimeType=x-scheme-handler/larixy;
Terminal=false
X-GNOME-UsesNotifications=true
Actions=open-settings;new-dm;

[Desktop Action open-settings]
Name=Open Settings
Exec=app.larixy.Larixy --larixy-task=open-settings %U

[Desktop Action new-dm]
Name=New Direct Message
Exec=app.larixy.Larixy --larixy-task=new-dm %U

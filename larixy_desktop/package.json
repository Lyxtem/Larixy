{
	"name": "larixy_desktop",
	"version": "0.0.0",
	"description": "Instant messaging and VoIP application",
	"homepage": "https://larixy.com",
	"author": "Larixy Platform AB <support@larixy.com>",
	"license": "AGPL-3.0-or-later",
	"private": true,
	"type": "module",
	"main": "dist/main/index.js",
	"scripts": {
		"build": "node scripts/build.mjs",
		"generate:windows-badges": "electron scripts/generate-windows-badges.mjs",
		"package:dir": "node scripts/build.mjs && electron-builder --config electron-builder.config.cjs --dir",
		"test": "vitest run",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@larixy/constants": "workspace:*",
		"@larixy/desktop_ipc": "workspace:*",
		"@larixy/instance_bootstrap": "workspace:*",
		"@larixy/ip_utils": "workspace:*",
		"@larixy/record_utils": "workspace:*",
		"@larixy/voice_engine_v2": "workspace:*",
		"@simplewebauthn/browser": "catalog:",
		"franc-min": "6.2.0",
		"hunspell-asm": "4.0.2",
		"undici": "catalog:",
		"velopack": "1.2.0"
	},
	"devDependencies": {
		"@types/node": "24.19.2",
		"electron": "44.10.0",
		"electron-builder": "27.0.0-alpha.8",
		"esbuild": "catalog:",
		"typescript": "catalog:ts7",
		"vitest": "catalog:"
	},
	"optionalDependencies": {
		"@larixy/app-store": "file:./native/app-store",
		"@larixy/gateway-socket": "file:./native/gateway-socket",
		"@larixy/hardware-encoder": "file:./native/hardware-encoder",

		"@larixy/win-game-capture": "file:./native/win-game-capture",
		"@larixy/win-process-loopback": "file:./native/win-process-loopback",
		"@larixy/win-shell": "file:./native/win-shell",
		"@larixy/windows-input-hook": "file:./native/windows-input-hook",
		"electron-log": "5.4.4"
	}
}

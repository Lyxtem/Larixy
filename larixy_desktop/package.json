		"@larixy/linux-input-hook": "file:./native/linux-input-hook",
		"@larixy/linux-notifications": "file:./native/linux-notifications",
		"@larixy/linux-portals": "file:./native/linux-portals",
		"@larixy/mac-app-audio": "file:./native/mac-app-audio",
		"@larixy/mac-clipboard": "file:./native/mac-clipboard",
		"@larixy/mac-screen-capture": "file:./native/mac-screen-capture",
		"@larixy/mac-sysctl": "file:./native/mac-sysctl",
		"@larixy/mac-tcc": "file:./native/mac-tcc",
		"@larixy/macos-input-hook": "file:./native/macos-input-hook",
		"@larixy/platform-info": "file:./native/platform-info",
		"@larixy/system-hunspell": "file:./native/system-hunspell",
		"@larixy/webauthn": "file:./native/webauthn",

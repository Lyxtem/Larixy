#
# Checked-in local development defaults. Private credentials and personal
# overrides belong in .env.local or config/env/local.env, both ignored by git.

LARIXY_ENV=development
NODE_ENV=development
LARIXY_BASE_DOMAIN=localhost
LARIXY_PUBLIC_SCHEME=http
LARIXY_PUBLIC_PORT=8088
LARIXY_STATIC_CDN_DOMAIN=localhost
LARIXY_PUBLIC_URL=http://localhost:8088
LARIXY_API_ENDPOINT=http://localhost:8088/api
LARIXY_API_CLIENT_ENDPOINT=http://localhost:8088/api
LARIXY_APP_ENDPOINT=http://localhost:8088
LARIXY_GATEWAY_ENDPOINT=ws://localhost:8088/gateway
LARIXY_MEDIA_ENDPOINT=http://localhost:8088/media
LARIXY_STATIC_CDN_ENDPOINT=http://localhost:8088
LARIXY_ADMIN_ENDPOINT=http://localhost:8088/admin
LARIXY_MARKETING_ENDPOINT=https://larixy.xyz
LARIXY_TRUST_CLIENT_IP_HEADER=true
LARIXY_CLIENT_IP_HEADER_NAME=x-forwarded-for

LARIXY_DATABASE_BACKEND=postgres
